{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "PIO: Upload + External Serial Monitor",
      "type": "process",
      "command": "${env:USERPROFILE}\\.platformio\\penv\\Scripts\\platformio.exe",
      "args": [
        "run",
        "--target",
        "upload_and_serial_gui"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "linux": {
        "command": "platformio"
      },
      "osx": {
        "command": "platformio"
      }
    },
    {
      "label": "PIO: Open External Serial Monitor",
      "type": "process",
      "command": "${env:USERPROFILE}\\.platformio\\penv\\Scripts\\python.exe",
      "args": [
        "${workspaceFolder}\\tools\\serial_monitor.py",
        "--project",
        "${workspaceFolder}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "never",
        "panel": "dedicated",
        "clear": false
      },
      "linux": {
        "command": "python3",
        "args": [
          "${workspaceFolder}/tools/serial_monitor.py",
          "--project",
          "${workspaceFolder}"
        ]
      },
      "osx": {
        "command": "python3",
        "args": [
          "${workspaceFolder}/tools/serial_monitor.py",
          "--project",
          "${workspaceFolder}"
        ]
      }
    }
  ]
}
