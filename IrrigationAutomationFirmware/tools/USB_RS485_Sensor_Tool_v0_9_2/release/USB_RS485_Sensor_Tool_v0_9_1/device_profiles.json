    {
      "id": "generic_soil_3in1",
      "label": "Generic Soil Sensor 3-in-1",
      "category": "soil",
      "status": "supported",
      "baud": 9600,
      "serial_config": "8N1",
      "address_range": [
        1,
        247
      ],
      "probe": {
        "request_no_crc": "AA 03 00 00 00 03",
        "response_length": 11,
        "response_prefix": "AA 03 06"
      },
      "read": {
        "request_no_crc": "AA 03 00 00 00 03",
        "response_length": 11,
        "response_prefix": "AA 03 06",
        "fields": [
          {
            "name": "soil_temperature",
            "label": "Soil Temperature",
            "register_offset": 0,
            "type": "int16",
            "scale": 0.01,
            "unit": "°C",
            "min": -40,
            "max": 85
          },
          {
            "name": "soil_vwc",
            "label": "Soil VWC",
            "register_offset": 1,
            "type": "uint16",
            "scale": 0.01,
            "unit": "%",
            "min": 0,
            "max": 100
          },
          {
            "name": "soil_ec",
            "label": "Soil EC",
            "register_offset": 2,
            "type": "uint16",
            "scale": 0.001,
            "unit": "mS/cm",
            "min": 0,
            "max": 30
          }
        ]
      },
      "change_address": {
        "supported": true,
        "mode": "modbus_template",
        "request_no_crc": "00 06 02 00 00 NN",
        "response_length": 8,
        "response_prefix": "00 06 02 00",
        "requires_single_device": true,
        "warning": "Broadcast-like command. Only one target sensor must be connected."
      }
    },
