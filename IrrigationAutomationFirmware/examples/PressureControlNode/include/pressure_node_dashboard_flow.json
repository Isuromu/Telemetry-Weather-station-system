  },
  {
    "id": "353da4a7ddcce2f4",
    "type": "ui-template",
    "z": "4e9925030f873fb0",
    "g": "bed8609050b3e817",
    "group": "ui_group_valve1_telemetry",
    "page": "",
    "ui": "",
    "name": "valve_1 state and commands",
    "order": 1,
    "width": "8",
    "height": "15",
    "head": "",
    "format": "<template>\n<div class=\"pn1\">\n  <div class=\"pn1-head\">\n    <strong>valve_1</strong>\n    <span v-if=\"state.last_seen\">Last uplink {{ local(state.last_seen) }} &middot; FCnt {{ show(state.f_cnt) }} &middot; {{ show(state.uplink_count) }} received</span>\n    <span v-else>Waiting for an FPort 31 status uplink</span>\n  </div>\n\n  <div class=\"pn1-grid\">\n    <div><small>Status reason</small><b>{{ show(state.status_reason) }}</b></div>\n    <div><small>Runtime mode</small><b>{{ show(state.runtime_mode) }}</b></div>\n    <div><small>PCV commanded</small><b>{{ show(state.pcv_last_commanded) }}</b></div>\n    <div><small>Position verified</small><b>{{ state.pcv_position_verified ? \"yes\" : \"no\" }}</b></div>\n    <div><small>Sleep interval</small><b>{{ sleepText(state.sleep_seconds) }}</b></div>\n    <div><small>Last command ID</small><b>{{ show(state.last_command_id) }}</b></div>\n    <div><small>Battery</small><b>{{ show(state.battery_voltage_v, \" V\") }}</b></div>\n    <div><small>Pressure upstream / downstream</small><b>{{ show(state.upstream_pressure_bar, \" bar\") }} / {{ show(state.downstream_pressure_bar, \" bar\") }}</b></div>\n    <div><small>Temperature upstream / downstream</small><b>{{ show(state.upstream_temperature_c, \" C\") }} / {{ show(state.downstream_temperature_c, \" C\") }}</b></div>\n    <div><small>Sensor scale</small><b>{{ state.upstream_scale_validated ? \"upstream validated\" : \"upstream not validated\" }} / {{ state.downstream_scale_validated ? \"downstream validated\" : \"downstream not validated\" }}</b></div>\n    <div><small>Flow meter</small><b>{{ show(state.flow_rate_m3_h, \" m3/h\") }}</b></div>\n    <div><small>Flow total since local reset</small><b>{{ show(state.flow_total_since_reset_m3, \" m3\") }}</b></div>\n    <div><small>Water velocity</small><b>{{ show(state.water_velocity_m_s, \" m/s\") }}</b></div>\n    <div><small>TUF error bits</small><b>{{ show(state.tuf_error_bits) }}</b></div>\n    <div><small>Radio</small><b>{{ radioText }}</b></div>\n    <div><small>Gateway</small><b>{{ state.gateway_id || \"-\" }}</b></div>\n  </div>\n\n  <div class=\"pn1-controls\">\n    <h3>Command valve_1</h3>\n    <p>valve_1 is Class A: it only hears a downlink in the receive window after one of its own uplinks, so every command below waits in ChirpStack until the node next wakes, and the node then sleeps for its configured interval. Each command is sent with a fresh command_id, because the node ignores an id it has already accepted. Flow total reset stores a new ESP32 baseline; it does not clear TUF-2000M totals.</p>\n    <div class=\"pn1-row\">\n      <v-text-field :model-value=\"sleep_seconds\" @update:model-value=\"onSleepInput\" type=\"number\" min=\"10\" max=\"86400\" step=\"1\" label=\"Sleep interval in seconds (10 to 86400)\" density=\"compact\"></v-text-field>\n      <span class=\"pn1-note\">{{ sleepNote }}</span>\n      <v-btn @click=\"sendSleep\" :disabled=\"!sleepValid\">Set sleep interval</v-btn>\n    </div>\n    <div class=\"pn1-row\">\n      <v-btn color=\"success\" @click=\"issue('open', true)\">Open + sleep</v-btn>\n      <v-btn color=\"error\" @click=\"issue('close', true)\">Close + sleep</v-btn>\n      <v-btn @click=\"issue('open', false)\">Open only</v-btn>\n      <v-btn @click=\"issue('close', false)\">Close only</v-btn>\n      <v-btn variant=\"text\" @click=\"issue('none', false)\">No-op test</v-btn>\n      <v-btn color=\"warning\" @click=\"resetFlowTotal\">Reset local flow total</v-btn>\n    </div>\n  </div>\n\n  <div class=\"pn1-footer\">\n    <div><b>Last downlink queued:</b> {{ state.sent_at ? local(state.sent_at) : \"-\" }}<span v-if=\"state.sent_object\"> &middot; ID {{ show(state.sent_command_id) }} &middot; {{ sentText }}</span></div>\n    <div><b>Delivery:</b> {{ state.sent_state || \"-\" }}</div>\n    <div><b>Last event:</b> {{ show(state.last_event) }} at {{ state.last_event_time ? local(state.last_event_time) : \"-\" }}<span v-if=\"state.network_ack\"> &middot; {{ state.network_ack }}</span><span v-if=\"state.network_txack\"> &middot; {{ state.network_txack }}</span><span v-if=\"state.network_join\"> &middot; joined {{ local(state.network_join) }}</span><span v-if=\"state.network_status\"> &middot; {{ state.network_status }}</span><span v-if=\"state.network_log\"> &middot; {{ state.network_log }}</span></div>\n    <div v-if=\"state.decode_error\" class=\"pn1-alert\">{{ state.decode_error }}</div>\n    <div v-if=\"state.ui_error\" class=\"pn1-alert\">{{ state.ui_error }}</div>\n    <div><v-btn variant=\"text\" size=\"small\" @click=\"show_raw = !show_raw\">{{ show_raw ? \"Hide\" : \"Show\" }} the raw status object</v-btn></div>\n    <pre v-if=\"show_raw\" class=\"pn1-raw\">{{ rawText }}</pre>\n  </div>\n</div>\n</template>\n<script>\nexport default {\n  data() {\n    return { state: {}, sleep_seconds: 60, touched: false, show_raw: false };\n  },\n  computed: {\n    sleepValid() {\n      const n = Number(this.sleep_seconds);\n      return Number.isInteger(n) && n >= 10 && n <= 86400;\n    },\n    sleepNote() {\n      if (!this.sleepValid) return \"whole number of seconds, 10 to 86400\";\n      const n = Number(this.sleep_seconds);\n      if (n >= 3600) return \"= \" + n + \" s (\" + (n / 3600).toFixed(2) + \" h)\";\n      if (n >= 60) return \"= \" + n + \" s (\" + (n / 60).toFixed(1) + \" min)\";\n      return \"= \" + n + \" s\";\n    },\n    sentText() {\n      return this.state.sent_object ? JSON.stringify(this.state.sent_object) : \"-\";\n    },\n    rawText() {\n      return this.state.raw ? JSON.stringify(this.state.raw, null, 1) : \"No FPort 31 status object received yet.\";\n    },\n    radioText() {\n      const parts = [];\n      if (this.state.rssi !== null && this.state.rssi !== undefined) parts.push(this.state.rssi + \" dBm\");\n      if (this.state.snr !== null && this.state.snr !== undefined) parts.push(this.state.snr + \" dB SNR\");\n      if (this.state.sf) parts.push(\"SF\" + this.state.sf);\n      if (this.state.dr !== null && this.state.dr !== undefined) parts.push(\"DR\" + this.state.dr);\n      if (this.state.frequency) parts.push((this.state.frequency / 1000000).toFixed(1) + \" MHz\");\n      return parts.length > 0 ? parts.join(\" | \") : \"-\";\n    }\n  },\n  watch: {\n    msg: {\n      handler(m) {\n        if (!m || !m.payload || m.payload.kind !== \"state\") return;\n        this.state = m.payload.state || {};\n        // Follow the interval the node is really sleeping for until the\n        // operator types a new one.\n        if (!this.touched && typeof this.state.sleep_seconds === \"number\" && this.state.sleep_seconds > 0) {\n          this.sleep_seconds = this.state.sleep_seconds;\n        }\n      },\n      immediate: true\n    }\n  },\n  methods: {\n    show(v, suffix) {\n      if (v === null || v === undefined || v === \"\") return \"-\";\n      return String(v) + (suffix || \"\");\n    },\n    local(iso) {\n      if (!iso) return \"-\";\n      const d = new Date(iso);\n      return isNaN(d.getTime()) ? String(iso) : d.toLocaleString();\n    },\n    sleepText(seconds) {\n      const n = Number(seconds);\n      if (!isFinite(n) || n <= 0) return \"-\";\n      if (n >= 3600) return n + \" s (\" + (n / 3600).toFixed(2) + \" h)\";\n      if (n >= 60) return n + \" s (\" + (n / 60).toFixed(1) + \" min)\";\n      return n + \" s\";\n    },\n    onSleepInput(value) {\n      this.touched = true;\n      this.sleep_seconds = value === \"\" || value === null || value === undefined ? null : Number(value);\n    },\n    sendSleep() {\n      if (!this.sleepValid) return;\n      this.state.ui_error = \"\";\n      this.send({ payload: { kind: \"command\", sleep_seconds: Number(this.sleep_seconds) } });\n    },\n    resetFlowTotal() {\n      if (!window.confirm(\"Reset valve_1 delivered-water baseline? The meter totals remain intact.\")) return;\n      this.state.ui_error = \"\";\n      this.send({ payload: { kind: \"command\", flow_total_reset: true } });\n    },\n    issue(pcv, withSleep) {\n      if (withSleep && !this.sleepValid) return;\n      const command = { kind: \"command\", pcv: pcv };\n      let text = pcv === \"none\" ? \"no valve movement\" : pcv.toUpperCase();\n      if (withSleep) {\n        command.sleep_seconds = Number(this.sleep_seconds);\n        text += \" plus a \" + command.sleep_seconds + \" second sleep interval\";\n      }\n      if (pcv === \"open\" || pcv === \"close\") {\n        if (!window.confirm(\"Send \" + text + \" to valve_1? The command is delivered after its next uplink.\")) return;\n      }\n      this.state.ui_error = \"\";\n      this.send({ payload: command });\n    }\n  }\n}\n</script>\n<style>\n.pn1{padding:8px}\n.pn1-head{display:flex;justify-content:space-between;gap:12px;align-items:center;font-size:1.15rem;flex-wrap:wrap}\n.pn1-head span{font-size:.8rem}\n.pn1-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:10px;margin:16px 0}\n.pn1-grid>div{padding:12px;border:1px solid #ccd7df;border-radius:8px}\n.pn1-grid small{display:block;color:#566}\n.pn1-grid b{font-size:1.05rem}\n.pn1-controls,.pn1-footer{border-top:1px solid #ccd7df;padding-top:12px;margin-top:12px}\n.pn1-controls p,.pn1-footer p{font-size:.85rem}\n.pn1-row{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:10px}\n.pn1-note{font-size:.85rem;color:#566;white-space:nowrap}\n.pn1-footer div{font-size:.85rem;margin-bottom:4px}\n.pn1-alert{background:#b3261e;color:white;border-radius:5px;padding:8px;margin:8px 0}\n.pn1-raw{background:#f4f7f9;border:1px solid #ccd7df;border-radius:5px;padding:8px;font-size:.75rem;overflow:auto;max-height:320px}\n</style>",
