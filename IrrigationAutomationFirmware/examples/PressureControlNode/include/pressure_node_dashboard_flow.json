    "name": "Build pressure battery and flow chart inputs",
    "func": "// Build Valve 1 chart inputs from decoded FPort 31 telemetry only.\nconst topic = String(msg.topic || \"\");\nif (topic && !topic.endsWith(\"/up\")) return null;\nconst event = msg.payload || {};\nif (event.fPort !== 31) return null;\nconst raw = event.object || {};\nfunction num(v) { return typeof v === \"number\" && isFinite(v) ? v : null; }\nconst pressure = [];\nconst upstream = num(raw.upstream_pressure_bar);\nconst downstream = num(raw.downstream_pressure_bar);\nif (upstream !== null) pressure.push({pn1Metric:\"pressure\",topic:\"Upstream\",payload:upstream});\nif (downstream !== null) pressure.push({pn1Metric:\"pressure\",topic:\"Downstream\",payload:downstream});\nconst battery = num(raw.battery_voltage_v);\nconst flowRate = num(raw.flow_rate_m3_h);\nreturn [pressure.length ? pressure : null,\n        battery !== null ? {pn1Metric:\"battery\",topic:\"Battery\",payload:battery} : null,\n        flowRate !== null ? {pn1Metric:\"flow\",topic:\"Flow Rate\",payload:flowRate} : null];",
