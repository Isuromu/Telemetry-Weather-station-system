    {
        "id": "sc_wl_stale",
        "type": "function",
        "z": "e618dcf23e3fb563",
        "g": "sc_wl_group_flow",
        "name": "Check stale status",
        "func": "// The node reports once per wake cycle and then deep-sleeps, so age is\n// measured from when an uplink reached Node-RED, not from the gateway\n// timestamp. The limit tracks the firmware's sleep interval (2 x it, floor\n// 60 s), so it tightens when the interval is short and never trips on one\n// lost uplink.\nconst STALE_AFTER_SECONDS = 60;\nconst s = Object.assign({}, flow.get('water_state') || {});\ns.stale_after_seconds = STALE_AFTER_SECONDS;\ns.stale = !s.last_seen_ms || Date.now() - s.last_seen_ms > STALE_AFTER_SECONDS * 1000;\nflow.set('water_state', s);\nmsg.payload = {kind:'state', state:s};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 430,
        "y": 300,
        "wires": [
            [
                "sc_wl_ui"
            ]
        ]
