        "format": "<template>\n<div class=\"pn2-zoom\">\n  <span>View {{ msg && msg.payload && msg.payload.kind === 'zoom_state' ? msg.payload.label : '6 h' }}</span>\n  <button type=\"button\" title=\"Zoom in: shorter time range\" aria-label=\"Zoom in\" @click=\"zoom(1)\">+</button>\n  <button type=\"button\" title=\"Zoom out: longer time range\" aria-label=\"Zoom out\" @click=\"zoom(-1)\">&minus;</button>\n</div>\n</template>\n<script>\nexport default {\n  methods: {\n    zoom(direction) {\n      this.send({payload:{kind:\"zoom\",metric:\"pressure\",direction}});\n    }\n  }\n}\n</script>\n<style>\n.pn2-zoom{height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;color:#566;font-size:.72rem}\n.pn2-zoom span{text-align:center;white-space:nowrap}\n.pn2-zoom button{width:27px;height:25px;padding:0;border:1px solid #b7c4ce;border-radius:5px;background:#f5f8fa;color:#203447;font-size:17px;line-height:1;cursor:pointer}\n.pn2-zoom button:hover{background:#e3edf4}\n</style>",
