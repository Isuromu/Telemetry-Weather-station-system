        "g": "ee3279020e9bc14e",
        "name": "Build chart and gauge inputs",
        "func": "// Chart and gauge inputs for the \"Valve 2 sub info\" group.\nconst topic = String(msg.topic || \"\");\nif (topic && topic.slice(-3) !== \"/up\") return null;\n\nconst event = msg.payload || {};\nconst raw = event.object || event;\n\nfunction num(v) { return typeof v === \"number\" && isFinite(v) ? v : null; }\n\nconst upstream = num(raw.upstream_pressure_bar);\nconst downstream = num(raw.downstream_pressure_bar);\n\nconst chartMsgs = [];\nif (upstream !== null) chartMsgs.push({ topic: \"Upstream\", payload: upstream });\nif (downstream !== null) chartMsgs.push({ topic: \"Downstream\", payload: downstream });\n\n// valve_2 has no flow meter, so the gauge follows the value the node reports\n// and is left untouched when the field is null. The old sqrt(dP) estimate\n// belonged to valve_1 and would be invented data here.\n// Not named \"flow\": a Function node already has the flow context in scope\n// under that name, and a local const of the same name will not compile.\nconst flowRate = num(raw.flow_rate_m3_h);\nconst battery = num(raw.battery_voltage_v);\n\nreturn [\n    chartMsgs.length > 0 ? chartMsgs : null,\n    flowRate !== null ? { topic: \"Flow Rate\", payload: Number(flowRate.toFixed(3)) } : null,\n    battery !== null ? { topic: \"Battery\", payload: battery } : null\n];",
